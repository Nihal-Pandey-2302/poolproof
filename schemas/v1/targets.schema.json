{
  "$defs": {
    "PoolMode": {
      "description": "Pooling mode of a target. Scenarios list the modes they apply to.",
      "enum": [
        "session",
        "transaction",
        "statement"
      ],
      "type": "string"
    },
    "ResetFile": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "all",
            "exact"
          ],
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "`reset` as written: \"auto\", \"all\", \"exact\", or a list of statements."
    },
    "TargetFile": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "direct": {
          "type": "string"
        },
        "ignore_server_requirements": {
          "default": false,
          "description": "Run scenarios that need one (or several) server connections even when the\nprobes say the pooler has otherwise. For Postgres used as its own pooler.",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/PoolMode"
        },
        "name": {
          "type": "string"
        },
        "pool_size": {
          "default": null,
          "description": "The pooler's pool size for this database and user (1 to 16), as configured\nthere. Needed by reset = \"exact\".",
          "format": "uint32",
          "maximum": 16,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "pooler": {
          "type": "string"
        },
        "product": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "reset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResetFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "pooler",
        "direct",
        "mode"
      ],
      "type": "object"
    }
  },
  "$id": "https://nihal-pandey-2302.github.io/poolproof/schemas/v1/targets.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A target as written in the file, before `${VAR}` substitution and URL parsing.",
  "properties": {
    "target": {
      "items": {
        "$ref": "#/$defs/TargetFile"
      },
      "type": "array"
    }
  },
  "required": [
    "target"
  ],
  "title": "poolproof targets file",
  "type": "object"
}
